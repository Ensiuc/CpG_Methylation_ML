# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# Jupyter notebooks checkpoints
.ipynb_checkpoints/

# Data files — do not commit raw/sensitive data
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Results — optional, can commit summary tables but not large outputs
results/figures/*
results/tables/*
!results/figures/.gitkeep
!results/tables/.gitkeep

# macOS
.DS_Store
.AppleDouble
.LSOverride

# IDE
.vscode/
.idea/
*.swp
*.swo

# Environment variables / secrets
.env
*.token
*.key

# Logs
*.log
logs/
